# ════════════════════════════════════════════════════════════════
#  Zero-Trust Vault — Environment Configuration Template
#  Copy this file to '.env' and fill in real values.
#  NEVER commit the real '.env' file to version control.
# ════════════════════════════════════════════════════════════════

# ─── SERVER ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE ────────────────────────────────────────────────────
# MongoDB connection URI
# Local:   mongodb://localhost:27017/zerotrust_vault
# Atlas:   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/zerotrust_vault
MONGO_URI=mongodb://localhost:27017/zerotrust_vault

# ─── JWT AUTHENTICATION ───────────────────────────────────────────
# Long, random secret for HMAC-SHA256 token signing.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_64_BYTE_RANDOM_HEX_STRING

# Token lifetime (e.g. '8h', '1d', '7d')
JWT_EXPIRES_IN=8h

# ─── FILE ENCRYPTION ─────────────────────────────────────────────
# Passphrase used by OpenSSL PBKDF2 to derive the AES-256 key + IV.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Changing this key will make existing encrypted files unreadable.
FILE_ENCRYPTION_KEY=REPLACE_WITH_A_STRONG_RANDOM_PASSPHRASE

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
